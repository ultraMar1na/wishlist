---
const { name='', title='', link = '' } = Astro.props;
---

<li>
    <label for={`item-${name}`} class="big-subitem">
        <div class="mini-checkbox-wrapper sr-only">
            <input type="checkbox" id={`item-${name}`} name={`item-${name}`} class="checkbox-gift"  />
        </div>
        { link && <a href={link} target="_blank" set:html={title}></a>}
        { !link && <div set:html={title}></div>}
    </label>
    <button class="btn">Забронювати</button>
</li>