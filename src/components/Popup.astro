---
const {id='', content='', bannerType='', banner, confirmText = 'Підтвердити', cancelText='Скасувати' } = Astro.props;
var bannerImage = banner;

if (!banner && bannerType === 'positive') {
  bannerImage = `/wishlist/twilight/happy.jpg`;
  //bannerImage = `/wishlist/spongebob/happy/1.jpg`;
}

if (!banner && bannerType === 'negative') {
    bannerImage = `/wishlist/twilight/sad.jpg`;
 // bannerImage = `/wishlist/spongebob/sad/1.jpg`;
}
---


<div id={id} class="dialog-overlay">
    <div class="dialog-content">
      <div class="dialog-body">
        <img src={bannerImage} alt="banner" />
      </div>
      <div class="dialog-footer">
        <p>{content}</p>
        <div class="dialog-actions">
          <button class="confirm-button btn btn-reverse">{confirmText}</button>
          <button class="cancel-button btn btn-reverse">{cancelText}</button>
        </div>
      </div>
    </div>
  </div>